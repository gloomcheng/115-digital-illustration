{
  "name": "115-digital-illustration",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:background": "astro dev --background",
    "build": "astro build",
    "typecheck": "astro check",
    "lint": "biome check .",
    "content:check": "sh scripts/content-standards.sh .",
    "live": "bun run scripts/live-game.ts",
    "shop": "bun run scripts/shop-sim/server.ts",
    "shop:sprites": "python3 scripts/shop-sim/make-sprites.py",
    "shop:preview": "python3 scripts/shop-sim/preview-client.py",
    "shop:chars": "python3 scripts/shop-sim/preview-chars.py",
    "shop:check": "bun run scripts/shop-sim/check-all.ts",
    "shop:e2e": "bun run scripts/shop-sim/e2e.ts",
    "shop:persist": "bun run scripts/shop-sim/persist-test.ts",
    "shop:rehearse": "bun run scripts/shop-sim/rehearsal.ts",
    "check:live": "bun run scripts/live-game-check.ts",
    "check:live:e2e": "bun run scripts/live-game-e2e.ts",
    "check:anchors": "node scripts/anchor-audit.mjs",
    "check:measure": "node scripts/measure-audit.mjs",
    "check:grid": "bun run scripts/grid-check.ts dist/weeks/1/index.html dist/weeks/2/index.html dist/weeks/3/index.html dist/weeks/4/index.html dist/weeks/5/index.html",
    "check:reading-windows": "node scripts/reading-window-harness.mjs",
    "check:ai-prose": "node scripts/ai-prose-guard.mjs",
    "quality": "npm run check:reading-windows && npm run check:ai-prose && npm run check:anchors && npm run check:measure && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.2"
  }
}
