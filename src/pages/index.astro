---
import { course } from '../data/course'
import { experiments } from '../data/labs'
import { site } from '../data/site'
import { weeks } from '../data/weeks'
import Layout from '../layouts/Layout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Layout title={site.title} description={course.promise}>
  <main>
    <section class="hero-scene relative isolate min-h-[calc(100svh-4.5rem)] overflow-hidden bg-night text-paper">
      <div class="hero-layer-stack absolute inset-0" data-hero-parallax="true" aria-hidden="true">
        <img src={`${base}/illustrations/hero-sky.webp`} alt="" class="hero-image hero-image-fallback absolute inset-0 h-full w-full object-cover" width="1916" height="821" fetchpriority="high" loading="eager" decoding="async" data-hero-layer="fallback" />
        <img src={`${base}/illustrations/hero-background.webp`} alt="" class="hero-layer hero-layer-background absolute inset-0 h-full w-full object-cover" width="1891" height="831" fetchpriority="low" loading="eager" decoding="async" data-hero-layer="background" data-parallax-speed="0.12" data-parallax-x="-0.06" onerror="this.remove()" />
        <img src={`${base}/illustrations/hero-clouds.webp`} alt="" class="hero-layer hero-layer-clouds absolute inset-0 h-full w-full object-cover" width="1891" height="831" fetchpriority="low" loading="eager" decoding="async" data-hero-layer="clouds" data-parallax-speed="-0.22" data-parallax-x="0.12" onerror="this.remove()" />
        <img src={`${base}/illustrations/hero-foreground.webp`} alt="" class="hero-layer hero-layer-foreground absolute inset-0 h-full w-full object-cover" width="1881" height="836" fetchpriority="low" loading="eager" decoding="async" data-hero-layer="foreground" data-parallax-speed="0.38" data-parallax-x="-0.2" onerror="this.remove()" />
      </div>
      <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>
      <div class="hero-depth hero-depth-clouds absolute inset-0" data-speed="0.18" aria-hidden="true"></div>
      <div class="hero-depth hero-depth-glow absolute inset-x-0 bottom-0 h-2/5" data-speed="0.32" aria-hidden="true"></div>
      <div class="relative mx-auto flex min-h-[calc(100svh-4.5rem)] max-w-7xl items-center px-5 py-20 sm:px-10 lg:px-10 lg:py-24">
        <div class="hero-copy max-w-2xl">
          <p class="font-mono text-xs font-bold tracking-[.18em] text-sun">靜宜大學 / {site.semester}</p>
          <h1 class="mt-5 max-w-3xl text-[clamp(2.5rem,6vw,5.8rem)] font-extrabold leading-[.98] tracking-[-.07em]">{site.title}</h1>
          <p class="mt-7 max-w-xl text-xl font-bold leading-9 text-paper sm:text-2xl">{site.subtitle}</p>
          <p class="mt-5 max-w-xl text-base leading-8 text-paper/85">你不用先會 Illustrator。先拿一個小想法，請 AI 試做幾次；看它改了什麼、漏了什麼，再決定下一步。</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`${base}/course`} class="rounded-full border-2 border-paper bg-paper px-6 py-3 text-sm font-bold text-ink shadow-[5px_5px_0_#ed765d]">看看這學期怎麼走</a>
            <a href={`${base}/style-lab`} class="rounded-full border-2 border-paper/80 bg-ink/35 px-6 py-3 text-sm font-bold text-paper backdrop-blur-sm">先做一次風格實驗</a>
          </div>
          <p class="mt-5 max-w-sm font-mono text-xs leading-5 text-paper/70">向下滑動，觀察背景山城、雲層與人物以不同速度移動。</p>
          <p class="mt-8 font-mono text-xs leading-5 text-paper/70">先把方向看清楚，再決定要不要把它做成 IP。</p>
        </div>
      </div>
    </section>

    <section class="paper-grid px-5 py-14 sm:px-10 lg:px-10 lg:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
          <div><p class="font-mono text-xs font-bold tracking-[.18em] text-coral">01 / 先做再懂</p><h2 class="mt-3 text-4xl font-extrabold tracking-[-.06em] sm:text-5xl">先做，不要先假裝懂</h2></div>
          <p class="max-w-2xl text-lg leading-8 text-blue">先做一張，你才會知道自己少說了什麼。下一輪只改一個地方，才知道結果為什麼不同。</p>
        </div>
        <div class="mt-10 grid auto-rows-fr gap-5 md:grid-cols-2 xl:grid-cols-4">
          {course.principles.map((principle, index) => <article class="story-card flex h-full min-h-44 flex-col rounded-2xl border-2 border-ink bg-paper p-6"><span class="font-mono text-sm font-bold text-blue">0{index + 1}</span><p class="mt-8 text-lg font-bold leading-8">{principle}</p></article>)}
        </div>
      </div>
    </section>

    <section class="bg-night px-5 py-14 text-paper sm:px-10 lg:px-10 lg:py-20">
      <div class="mx-auto max-w-7xl"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="font-mono text-xs font-bold tracking-[.18em] text-sun">02 / 前八週</p><h2 class="mt-3 text-4xl font-extrabold tracking-[-.06em] sm:text-5xl">先把你說不清楚的風格拆開來看</h2></div><a href={`${base}/course`} class="ink-link text-sm font-bold">看看全部的課程進度 →</a></div><div class="mt-10 grid auto-rows-fr gap-4 md:grid-cols-2 lg:grid-cols-4">{weeks.slice(0, 8).map((week) => <a href={`${base}/weeks/${week.number}`} class="story-card group flex h-full flex-col rounded-2xl border-2 border-paper/60 bg-paper/5 p-5 text-paper transition-colors hover:bg-paper hover:text-ink"><div class="flex items-center justify-between gap-4 font-mono text-xs"><span class="text-sun">W{String(week.number).padStart(2, '0')}</span><span class="text-right text-paper/65 group-hover:text-blue">{week.owner}</span></div><h3 class="mt-7 text-xl font-bold leading-8 group-hover:text-ink">{week.title}</h3><p class="mt-3 flex-1 text-sm leading-7 text-paper/70 group-hover:text-ink/75">{week.question}</p></a>)}</div></div>
    </section>

    <section class="relative overflow-hidden bg-coral px-5 py-16 text-[#071f34] sm:px-10 lg:px-10 lg:py-24">
      <div class="pointer-events-none absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full border-2 border-ink/20" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-56 -left-40 h-[30rem] w-[30rem] rounded-full border-2 border-paper/25" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl">
        <div class="max-w-4xl">
          <p class="font-mono text-xs font-bold tracking-[.18em]">03 / 試做幾輪</p>
          <h2 class="mt-3 text-4xl font-extrabold tracking-[-.06em] sm:text-5xl">把「我覺得」變成下一個實驗</h2>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-[#071f34]">如果最後要把作品交給別人，你不能只挑一張好看的。試著再做幾張、換一個用途，看看角色還認不認得出來；也記下下一輪到底要改哪裡。</p>
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1.12fr)_minmax(22rem,.88fr)] lg:items-stretch">
          <figure class="flex min-w-0 flex-col">
            <div class="overflow-hidden rounded-[1.5rem] border-2 border-ink bg-paper">
              <img src={`${base}/illustrations/rapid-trial.webp`} alt="原創插畫：同一角色的多張候選圖在畫桌上比較，經過單一變因實驗後留下下一輪方向。" class="block aspect-[16/9] h-full w-full object-cover" width="1672" height="941" loading="lazy" decoding="async" />
            </div>
            <figcaption class="mt-4 flex flex-wrap items-baseline justify-between gap-3 font-mono text-xs leading-5 text-[#071f34]">
              <span>一次只改一件事；不然你不知道差異從哪裡來。</span>
              <span class="text-[#071f34]">先看清楚，再改一件事</span>
            </figcaption>
          </figure>

          <ol class="relative grid gap-3 border-l-2 border-ink/40 pl-7 sm:pl-9 lg:py-1">
            {experiments.slice(0, 4).map((experiment) => <li class="relative min-w-0">
              <span class="absolute -left-[2.25rem] top-5 grid h-8 w-8 place-items-center rounded-full border-2 border-ink bg-sun font-mono text-xs font-bold text-ink sm:-left-[2.65rem]">{String(experiment.number).padStart(2, '0')}</span>
              <article class="h-full rounded-2xl border-2 border-ink bg-paper/80 p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2 font-mono text-xs font-bold">
                  <span>第 {experiment.number} 輪</span>
                  <span class="text-blue">這輪留下：{experiment.output}</span>
                </div>
                <h3 class="mt-4 text-xl font-extrabold leading-8">{experiment.title}</h3>
                <p class="mt-3 text-sm leading-7">{experiment.question}</p>
              </article>
            </li>)}
          </ol>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  let homeFrame = 0
  const updateHomeParallax = () => {
    if (homeFrame) return
    homeFrame = window.requestAnimationFrame(() => {
      homeFrame = 0
      const scene = document.querySelector<HTMLElement>('.hero-scene')
      if (!scene) return
      const progress = Math.min(Math.max(window.scrollY / Math.max(scene.offsetHeight, 1), 0), 1)
      const travel = scene.offsetHeight * 0.8
      scene.style.setProperty('--hero-scroll-shift', `${(progress * travel * 0.2).toFixed(2)}px`)
      scene.querySelectorAll<HTMLElement>('[data-parallax-speed]').forEach((layer) => {
       const speed = Number(layer.dataset.parallaxSpeed ?? 0)
        const horizontalSpeed = Number(layer.dataset.parallaxX ?? 0)
       layer.style.setProperty('--hero-layer-shift', `${(progress * speed * travel).toFixed(2)}px`)
        layer.style.setProperty('--hero-layer-x', `${(progress * horizontalSpeed * travel).toFixed(2)}px`)
      })
    })
  }
  updateHomeParallax()
  window.addEventListener('scroll', updateHomeParallax, { passive: true })
</script>
