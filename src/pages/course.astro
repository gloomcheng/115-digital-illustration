---
import { careerDirections, course } from '../data/course'
import { weeks } from '../data/weeks'
import Layout from '../layouts/Layout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Layout title="課程進度" description={`${course.title} 的每週任務與作品證據`}>
  <main>
    <section class="relative isolate min-h-[min(760px,calc(100svh-84px))] overflow-hidden bg-night text-paper">
      <img src={`${base}/illustrations/storybook-spread.png`} alt="原創插畫：一本打開的動態繪本，頁面上有角色、雲層、海岸城市與連續場景。" class="absolute inset-0 h-full w-full object-cover object-center" />
      <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-night/90 via-night/55 to-transparent" aria-hidden="true"></div>
      <div class="relative mx-auto flex min-h-[min(760px,calc(100svh-84px))] max-w-7xl items-end px-5 pb-16 pt-20 sm:px-10 lg:items-center lg:px-10 lg:pb-20">
        <div class="max-w-2xl">
          <p class="font-mono text-xs font-bold tracking-[.18em] text-sun">這學期 / 課程進度</p>
          <p class="mt-5 max-w-xl text-lg font-bold leading-8 text-paper/90">{course.title}</p>
          <h1 class="mt-3 text-5xl font-extrabold leading-[.98] tracking-[-.07em] text-paper sm:text-7xl lg:text-8xl">這學期怎麼走<br /><span class="text-sun">每週做什麼</span></h1>
          <p class="mt-7 max-w-xl text-base leading-8 text-paper/85 sm:text-lg">你會先從一張圖開始，慢慢學會怎麼看風格、怎麼挑工具、怎麼把做壞的地方記下來。故事、分鏡和鏡頭語言，會和另一位老師一起接上。</p>
          <a href={`${base}/animation-lab`} class="mt-7 inline-flex items-center border-b-2 border-sun pb-1 font-mono text-sm font-bold text-paper transition-colors hover:text-sun focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-sun/50">先看看動圖怎麼接進作品 ↗</a>
        </div>
      </div>
    </section>

    <section class="paper-grid px-5 py-12 sm:px-10 lg:px-10 lg:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-3 border-b-2 border-ink pb-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-mono text-xs font-bold tracking-[.18em] text-blue">每週要做什麼</p>
            <h2 class="mt-2 text-3xl font-extrabold tracking-[-.05em] text-ink sm:text-4xl">每週都留下一點，讓你知道自己怎麼走到這裡。</h2>
          </div>
          <p class="max-w-sm text-sm leading-7 text-blue">不用一次把所有工具學完。每週先做一件小事；做完，你會比較知道下一步要往哪裡走。</p>
        </div>
        <div class="overflow-hidden rounded-2xl border-2 border-ink bg-paper shadow-[8px_8px_0_rgba(13,94,130,.14)]">
          <div class="hidden grid-cols-[70px_1.45fr_1fr_1.2fr_1fr] border-b-2 border-ink bg-sun px-5 py-4 font-mono text-xs font-bold tracking-[.12em] md:grid"><span>週次</span><span>這週做什麼</span><span>誰帶這段</span><span>這週先想什麼</span><span>做完留下什麼</span></div>
          {weeks.map((week) => <a href={`${base}/weeks/${week.number}`} class="group grid gap-3 border-b border-ink/15 px-5 py-6 transition-colors last:border-0 hover:bg-sky focus-visible:bg-sky focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-coral/40 md:grid-cols-[70px_1.45fr_1fr_1.2fr_1fr] md:items-start md:gap-5"><div class="font-mono text-sm font-bold text-blue">W{String(week.number).padStart(2, '0')}</div><div><h3 class="text-xl font-extrabold leading-8 group-hover:text-blue">{week.title}</h3>{week.note && <p class="mt-1 font-mono text-xs text-blue">{week.note}</p>}<p class="mt-3 text-sm leading-7 text-ink/80">{week.content}</p><p class="mt-2 text-sm leading-7 text-ink/70 md:hidden">{week.assignment}</p></div><div class="text-sm font-bold text-blue">{week.owner}</div><p class="hidden text-sm leading-7 text-ink/75 md:block">{week.question}</p><p class="hidden text-sm leading-7 text-ink/75 md:block">{week.evidence}</p></a>)}
        </div>
      </div>
    </section>

    <section class="bg-night px-5 py-16 text-paper sm:px-10 lg:px-10 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <p class="font-mono text-xs font-bold tracking-[.18em] text-sun">AI 時代，這些能力往哪裡去</p>
        <h2 class="mt-3 max-w-4xl text-4xl font-extrabold tracking-[-.06em] sm:text-5xl">你不是只在學一套出圖流程。</h2>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-paper/85">AI 會讓第一張圖變快，但它沒有替你決定誰要看、畫面怎麼說、哪個版本能繼續做。這些判斷會跟著你走進數位媒體、資訊傳播、大眾傳播和設計工作。</p>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {careerDirections.map((direction, index) => <article class="rounded-2xl border-2 border-paper/40 bg-paper/10 p-6"><div class="flex items-center justify-between gap-4"><span class="font-mono text-sm font-bold text-sun">0{index + 1}</span><span class="font-mono text-xs text-paper/70">一條可能的路</span></div><h3 class="mt-7 text-2xl font-extrabold">{direction.title}</h3><p class="mt-3 text-base leading-8 text-paper/85">{direction.detail}</p><p class="mt-5 border-t border-paper/20 pt-4 text-sm font-bold leading-7 text-sun">可能接到：{direction.roles}</p><a href={direction.source} target="_blank" rel="noreferrer" class="mt-5 inline-block font-mono text-xs text-paper underline decoration-sun decoration-2 underline-offset-4 hover:text-sun focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-sun/50">看教育與職涯資料 ↗</a></article>)}
        </div>
        <p class="mt-8 max-w-4xl text-sm leading-7 text-paper/80">學類分工參考教育部 ColleGo!；AI 協作與責任參考<a href="https://www.dlc.ntu.edu.tw/ai-tools/" target="_blank" rel="noreferrer" class="mx-1 underline decoration-sun decoration-2 underline-offset-4 hover:text-sun">臺大生成式 AI 教學因應措施</a>與<a href="https://moda.gov.tw/ADI/services/publications/19692" target="_blank" rel="noreferrer" class="mx-1 underline decoration-sun decoration-2 underline-offset-4 hover:text-sun">數位發展部 AI 產業人才認定指引</a>。這些職涯連結是可能的延伸，不是就業承諾。</p>
      </div>
    </section>
  </main>
</Layout>
